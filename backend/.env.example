# 本地 embedding 配置示例。
# 后端 PyInstaller 构建时使用的 Python 解释器；在其他机器上请指向你的本地环境。
PYTHON_BIN="python.exe"
OC_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OC_EMBEDDING_API_KEY=your-dashscope-api-key
OC_EMBEDDING_MODEL=text-embedding-v4
OC_EMBEDDING_DIMENSION=1024

# 记录 Chroma 增量同步和 embedding 调用细节；调试时设为 true。
OC_INDEXING_DEBUG_LOG=true

# 开发模式：将详细的 agent / graph 错误流式输出到前端。
OC_DEV_MODE=true

# Chat LLM 配置，适用于 OpenRouter 以及其他兼容 OpenAI 接口的服务；provider=mock 表示离线桩实现。
OC_LLM_PROVIDER=openai
OC_LLM_BASE_URL=https://openrouter.ai/api/v1
OC_LLM_API_KEY=your-openrouter-api-key
OC_LLM_MODEL=deepseek/deepseek-chat

# 结构化输出策略。对于不支持 tool_choice 的 thinking / reasoning 模型，可使用 plain_json。
# 可选项：function_calling,json_mode,plain_json
OC_LLM_STRUCTURED_METHODS=function_calling,json_mode,plain_json

# 当模型提供 reasoning_content 时，是否流式输出该内容。主要支持 reasoning / thinking 模型。
OC_LLM_STREAM_REASONING=false

# 可选的快速 / 非 thinking 模型，仅供 chat_assembler 用于最终回复润色。
# 将 OC_LLM_REPLY_MODEL 留空则复用 OC_LLM_MODEL。
OC_LLM_REPLY_MODEL=
OC_LLM_REPLY_STREAM_REASONING=false

# 每轮 agent 注入的最大检索上下文 token 数；超过上限时按相关性裁剪。
OC_AGENT_CONTEXT_TOKEN_CAP=6000

# 网页搜索配置（Tavily）。API key 留空时，web_search 会返回友好的降级提示。
OC_WEB_SEARCH_PROVIDER=tavily
OC_WEB_SEARCH_API_KEY=
OC_WEB_SEARCH_TIMEOUT=10

# 角色 LoRA 训练服务（AutoDL / GPU 服务器），未配置时前端显示训练服务离线并走资料兜底。
OC_ROLE_FINETUNE_BASE_URL=http://127.0.0.1:9100
OC_ROLE_FINETUNE_TIMEOUT=20
